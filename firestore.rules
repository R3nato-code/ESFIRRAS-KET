rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true;
    }

    function isValidTransition(from, to) {
      return (from == 'pendente' && to == 'em_preparacao')
        || (from == 'em_preparacao' && to == 'pronto')
        || (from == 'pronto' && to == 'entregue')
        || (from == 'em_preparacao' && to == 'pendente')
        || (from == 'pronto' && to == 'em_preparacao')
        || (from == 'entregue' && to == 'pronto')
        || (to == 'cancelado'
          && (from == 'pendente' || from == 'em_preparacao' || from == 'pronto'));
    }

    function requiresReason(from, to) {
      return to == 'cancelado'
        || (from == 'em_preparacao' && to == 'pendente')
        || (from == 'pronto' && to == 'em_preparacao')
        || (from == 'entregue' && to == 'pronto');
    }

    function validCatalogDetails(item) {
      let productId = item.id;
      let expectedName = productId == 'carne' ? 'Carne'
        : productId == 'carne-com-queijo' ? 'Carne com queijo'
        : productId == 'chocolate-com-mm' ? 'Chocolate com MM'
        : productId == 'chocolate-com-granulado' ? 'Chocolate com granulado'
        : '';
      let expectedCategory = (productId == 'carne'
          || productId == 'carne-com-queijo') ? 'salgadas'
        : (productId == 'chocolate-com-mm'
          || productId == 'chocolate-com-granulado') ? 'doces'
        : '';
      let expectedPrice = (productId == 'carne'
          || productId == 'carne-com-queijo') ? 500
        : (productId == 'chocolate-com-mm'
          || productId == 'chocolate-com-granulado') ? 600
        : 0;

      return expectedPrice > 0
        && item.name == expectedName
        && item.category == expectedCategory
        && item.unitPrice == expectedPrice;
    }

    function validCatalogItem(item) {
      return item is map ? validCatalogItemMap(item) : false;
    }

    function validCatalogItemMap(item) {
      return item.keys().hasAll([
        'id', 'name', 'category', 'quantity', 'unitPrice', 'totalPrice'
      ]) && item.keys().hasOnly([
        'id', 'name', 'category', 'quantity', 'unitPrice', 'totalPrice'
      ]) ? validCatalogItemFields(item) : false;
    }

    function validCatalogItemFields(item) {
      return item.id is string
        && item.name is string
        && item.category is string
        && item.quantity is int
        && item.unitPrice is int
        && item.totalPrice is int
        ? item.quantity >= 1
          && item.quantity <= 20
          && item.totalPrice == item.quantity * item.unitPrice
          && validCatalogDetails(item)
        : false;
    }

    function validItems(data) {
      return data.items is list
        ? validItemsList(data.items, data)
        : false;
    }

    function validItemsList(items, data) {
      let itemCount = items.size();
      return itemCount >= 1 && itemCount <= 4
        ? validItemsNonEmpty(items, data, itemCount)
        : false;
    }

    function validItemsNonEmpty(items, data, itemCount) {
      return (
        validCatalogItem(items[0])
        && (itemCount < 2 ? true : validCatalogItem(items[1]))
        && (itemCount < 3 ? true : validCatalogItem(items[2]))
        && (itemCount < 4 ? true : validCatalogItem(items[3]))
      ) ? validUniqueItems(items, data, itemCount) : false;
    }

    function validUniqueItems(items, data, itemCount) {
      return (
        (itemCount < 2 ? true : items[0].id != items[1].id)
        && (itemCount < 3 ? true : (
          items[0].id != items[2].id
          && items[1].id != items[2].id
        ))
        && (itemCount < 4 ? true : (
          items[0].id != items[3].id
          && items[1].id != items[3].id
          && items[2].id != items[3].id
        ))
      ) ? validOrderTotals(items, data, itemCount) : false;
    }

    function validOrderTotals(items, data, itemCount) {
      let calculatedItems = items[0].quantity
        + (itemCount >= 2 ? items[1].quantity : 0)
        + (itemCount >= 3 ? items[2].quantity : 0)
        + (itemCount >= 4 ? items[3].quantity : 0);
      let calculatedAmount = items[0].totalPrice
        + (itemCount >= 2 ? items[1].totalPrice : 0)
        + (itemCount >= 3 ? items[2].totalPrice : 0)
        + (itemCount >= 4 ? items[3].totalPrice : 0);

      return data.totalItems == calculatedItems
        && data.totalAmount == calculatedAmount;
    }

    match /pedidos/{pedidoId} {
      function validCreate(data) {
        return data.keys().hasAll([
          'items', 'customerName', 'pickupLocation',
          'totalItems', 'totalAmount', 'status', 'createdAt'
        ]) && data.keys().hasOnly([
          'items', 'customerName', 'customerContact', 'notes',
          'pickupLocation', 'totalItems', 'totalAmount',
          'paymentMethod', 'status', 'createdAt'
        ]) ? validCreateTypes(data) : false;
      }

      function validCreateTypes(data) {
        return data.customerName is string
          && data.pickupLocation is string
          && data.totalItems is int
          && data.totalAmount is int
          ? validCreateBounds(data)
          : false;
      }

      function validCreateBounds(data) {
        return data.customerName.size() >= 1
          && data.customerName.size() <= 120
          && data.pickupLocation.size() >= 1
          && data.pickupLocation.size() <= 120
          && data.totalItems >= 1
          && data.totalItems <= 80
          && data.totalAmount >= 1
          && data.totalAmount <= 5000000
          && data.status == 'pendente'
          && data.createdAt == request.time
          ? validCreateOptionalFields(data)
          : false;
      }

      function validCreateOptionalFields(data) {
        let validNotes = data.keys().hasAny(['notes'])
          ? (data.notes is string ? data.notes.size() <= 280 : false)
          : true;
        let validContact = data.keys().hasAny(['customerContact'])
          ? (data.customerContact is string ? data.customerContact.size() <= 20 : false)
          : true;
        let validPayment = data.keys().hasAny(['paymentMethod'])
          ? data.paymentMethod in ['pix', 'dinheiro', 'cartao']
          : true;

        return validNotes && validContact && validPayment
          ? validItems(data)
          : false;
      }

      function validStatusUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return before.keys().hasAll(['status'])
          && after.keys().hasAll([
            'status', 'updatedAt', 'statusUpdatedAt',
            'statusUpdatedBy', 'lastHistoryId'
          ])
          && after.diff(before).affectedKeys().hasOnly([
            'status', 'updatedAt', 'statusUpdatedAt',
            'statusUpdatedBy', 'lastHistoryId'
          ])
          && after.status is string
          && after.status != before.status
          && isValidTransition(before.status, after.status)
          && after.updatedAt == request.time
          && after.statusUpdatedAt == request.time
          && after.statusUpdatedBy is map
          && after.statusUpdatedBy.keys().hasAll(['uid', 'email'])
          && after.statusUpdatedBy.keys().hasOnly(['uid', 'email'])
          && after.statusUpdatedBy.uid == request.auth.uid
          && after.statusUpdatedBy.email == request.auth.token.get('email', '')
          && after.lastHistoryId is string
          && after.lastHistoryId.size() > 0
          && after.lastHistoryId.size() <= 120;
      }

      function matchingHistory() {
        let after = request.resource.data;
        let historyPath = /databases/$(database)/documents/pedidos/$(pedidoId)/historico/$(after.lastHistoryId);
        let history = getAfter(historyPath);
        return existsAfter(historyPath)
          && history.data.pedidoId == pedidoId
          && history.data.fromStatus == resource.data.status
          && history.data.toStatus == after.status
          && history.data.changedAt == request.time
          && history.data.changedBy.uid == request.auth.uid
          && history.data.changedBy.email == request.auth.token.get('email', '');
      }

      allow create: if validCreate(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && validStatusUpdate() && matchingHistory();
      allow delete: if false;

      match /historico/{historyId} {
        function validHistoryCreate() {
          let data = request.resource.data;
          let beforeOrder = get(/databases/$(database)/documents/pedidos/$(pedidoId));
          let afterOrder = getAfter(/databases/$(database)/documents/pedidos/$(pedidoId));
          return beforeOrder != null
            && afterOrder != null
            && afterOrder.data.lastHistoryId == historyId
            && data.keys().hasAll([
              'pedidoId', 'fromStatus', 'toStatus', 'changedAt', 'changedBy'
            ])
            && data.keys().hasOnly([
              'pedidoId', 'fromStatus', 'toStatus',
              'changedAt', 'changedBy', 'reason'
            ])
            && data.pedidoId == pedidoId
            && data.fromStatus == beforeOrder.data.status
            && data.toStatus == afterOrder.data.status
            && isValidTransition(beforeOrder.data.status, data.toStatus)
            && data.changedAt == request.time
            && data.changedBy is map
            && data.changedBy.keys().hasAll(['uid', 'email'])
            && data.changedBy.keys().hasOnly(['uid', 'email'])
            && data.changedBy.uid == request.auth.uid
            && data.changedBy.email == request.auth.token.get('email', '')
            && (!data.keys().hasAny(['reason'])
              || (data.reason is string && data.reason.size() <= 280))
            && (!requiresReason(beforeOrder.data.status, data.toStatus)
              || (data.keys().hasAny(['reason'])
                && data.reason is string && data.reason.size() >= 3));
        }

        allow read: if isAdmin();
        allow create: if isAdmin() && validHistoryCreate();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}