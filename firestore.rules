rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de pedidos: cria e lê (para o cardápio/status).
    // Ajuste para produção depois (ex.: exigir auth ou App Check).
    match /pedidos/{pedidoId} {
      allow create: if isValidOrder(request.resource.data);
      allow read: if true;
      // Não permite editar nem apagar pelo cliente.
      allow update, delete: if false;
    }

    // Bloqueia todo o resto por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // Validação mínima do pedido: campos obrigatórios com os tipos certos.
  function isValidOrder(data) {
    return data.keys().hasAll([
        'items', 'customerName', 'pickupLocation',
        'totalItems', 'totalAmount', 'status', 'createdAt'
      ])
      && data.items is list
      && data.items.size() > 0
      && data.customerName is string
      && data.customerName.size() > 0
      && data.pickupLocation is string
      && data.totalItems is int
      && data.totalItems > 0
      && data.totalAmount is int
      && data.totalAmount > 0
      && data.status is string;
  }
}
