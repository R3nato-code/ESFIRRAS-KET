# Firebase — Console Firebase > Configurações do projeto > Seus apps > SDK
#
# O painel é um app separado, mas usa o mesmo projeto Firebase do site.
# Localmente, o Vite lê automaticamente o .env da raiz do repositório.
# No Render, cadastre estas 6 chaves no serviço estático do admin.
#
# Este arquivo serve como referência; não é necessário preenchê-lo se o
# .env da raiz já estiver configurado.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública reCAPTCHA Enterprise registrada no Firebase App Check.
# Configure a mesma chave nos serviços do site e do painel no Render.
VITE_FIREBASE_APPCHECK_SITE_KEY=
