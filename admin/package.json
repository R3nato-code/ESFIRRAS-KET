{
  "name": "foxy-esfirras-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-esfirra-ket \"vitest run --config vitest.rules.config.ts\"",
    "smoke:prod": "node --env-file=../.env scripts/smoke-prod.mjs",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Painel administrativo de pedidos da Foxy Esfirras",
  "license": "ISC",
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
