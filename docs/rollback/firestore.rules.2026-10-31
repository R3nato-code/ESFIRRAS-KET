rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cole├º├úo de pedidos: cria e l├¬ (para o card├ípio/status).
    // Ajuste para produ├º├úo depois (ex.: exigir auth ou App Check).
    match /pedidos/{pedidoId} {
      allow create: if isValidOrder(request.resource.data);
      allow read: if true;
      // N├úo permite editar nem apagar pelo cliente.
      allow update, delete: if false;
    }

    // Bloqueia todo o resto por padr├úo.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // Valida├º├úo m├¡nima do pedido: campos obrigat├│rios com os tipos certos.
  function isValidOrder(data) {
    return data.keys().hasAll([
        'items', 'customerName', 'pickupLocation',
        'totalItems', 'totalAmount', 'status', 'createdAt'
      ])
      && data.items is list
      && data.items.size() > 0
      && data.customerName is string
      && data.customerName.size() > 0
      && data.pickupLocation is string
      && data.totalItems is int
      && data.totalItems > 0
      && data.totalAmount is int
      && data.totalAmount > 0
      && data.status is string;
  }
}
